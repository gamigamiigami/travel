{
  "manifest_version": 3,
  "name": "Yahoo!トラベル スペシャルクーポン ウォッチャー",
  "version": "2.3.0",
  "description": "Yahoo!トラベルのスペシャルクーポン（1,000〜50,000円OFF）が出たら、PCとスマホに通知します。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.travel.yahoo.co.jp/*",
    "*://*.yahoo.co.jp/*",
    "*://*.yimg.jp/*",
    "https://ntfy.sh/*",
    "https://discord.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.yahoo.co.jp/*",
        "*://*.yimg.jp/*"
      ],
      "all_frames": true,
      "js": [
        "src/detector.js",
        "src/messaging.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "クーポンウォッチャー",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
