# このファイルを .env という名前でコピーして使ってください。
# .env は .gitignore 済みです。ここに書いた値は config.yaml より優先されます。

# ===== ntfy（スマホ通知・推奨） =====
# 他人に推測されない長めのランダム文字列にしてください。
# この名前を知っている人は誰でもあなたの通知を読めます。
NTFY_TOPIC=

# ===== Discord（使う場合） =====
DISCORD_WEBHOOK_URL=

# ===== メール（使う場合） =====
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
